
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>KRAKESMP | Owner Panel</title>
  <link rel="stylesheet" href="style.css">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
<header>
  <h1>👑 KRAKESMP OWNER</h1>
  <p>OFFICIAL ADMIN DASHBOARD</p>
</header>

<main>
  <div class="card">
    <h2>🔐 OWNER LOGIN</h2>
    <div id="loginPanel">
      <input id="email" type="email" placeholder="Admin E-Mail">
      <input id="password" type="password" placeholder="Passwort">
      <button onclick="adminLogin()">ANMELDEN</button>
    </div>
    <p id="status" class="small">Bitte anmelden.</p>
  </div>

  <div id="adminPanel" class="hidden">
    <div class="card">
      <h2>👑 OWNER STATUS</h2>
      <p class="green">OWNER PANEL</p>
      <button onclick="loadAdminData()">AKTUALISIEREN</button>
      <button class="secondary" onclick="logout()">ABMELDEN</button>
    </div>

    <div class="card">
      <h2>📊 STATISTIKEN</h2>
      <div class="stats">
        <div class="stat">Spieler<b id="playerCount">0</b></div>
        <div class="stat">Gesamtguthaben<b id="totalBalance">0</b></div>
      </div>
    </div>

    <div class="card">
      <h2>👥 SPIELERVERWALTUNG</h2>
      <div id="players">Lade Spieler...</div>
    </div>

    <div class="card">
      <h2>💰 EINZAHLUNGEN</h2>
      <div id="deposits">Lade Anfragen...</div>
    </div>

    <div class="card">
      <h2>💸 AUSZAHLUNGEN</h2>
      <div id="payouts">Lade Anfragen...</div>
    </div>
  </div>
</main>

<footer>KRAKESMP · OWNER SYSTEM</footer>

<script src="app.js"></script>
<script src="admin.js"></script>
</body>
</html>
